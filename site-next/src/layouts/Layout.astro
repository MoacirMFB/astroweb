---
import SocialIcon from "../components/SocialIcon.astro";
import CosmicBackdrop from "../components/CosmicBackdrop.astro";
import "../styles/site.css";
interface Props {
  title?: string;
  description?: string;
  lang?: string;
}
const {
  title = "Moacir Fonseca Becker | Asteroid exploration & astrodynamics",
  description = "Asteroid interception, exploration, and space mission design. Moacir Fonseca Becker, PhD student in Aeronautics and Astronautics at Purdue University.",
  lang = "en",
} = Astro.props;
const es = lang === "es";
const base = es ? "/es/" : "/";
const current = Astro.url.pathname;
const page = current.replace(/^\/es\/?/, "/");
const alternate = es ? page : "/es" + current;
const links = [
  ["research", es ? "Investigación" : "Research"],
  ["projects", es ? "Proyectos" : "Projects"],
  ["about", es ? "Sobre mí" : "About"],
  ["contact", es ? "Contacto" : "Contact"],
];
---

<!doctype html>
<html lang={lang} data-motion="off">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#080c11" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta
      property="og:image"
      content="https://moacir.space/space/bennu-spin.jpg"
    />
    <link rel="canonical" href={new URL(current, Astro.site)} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body>
    <CosmicBackdrop />
    <a class="skip-link" href="#main">
      {es ? "Ir al contenido" : "Skip to content"}
    </a>
    <header class="site-header wrap">
      <a class="brand" href={base} aria-label="Moacir Fonseca Becker, home">
        <svg viewBox="0 0 44 44" aria-hidden="true">
          <circle cx="22" cy="22" r="10" />
          <ellipse
            cx="22"
            cy="22"
            rx="21"
            ry="7"
            transform="rotate(-40 22 22)"
          />
          <circle class="brand-dot" cx="36" cy="10" r="3" />
        </svg>
        <span>
          Moacir<span class="brand-surname">Fonseca Becker</span>
        </span>
      </a>
      <nav
        class="desktop-nav"
        aria-label={es ? "Navegación principal" : "Main navigation"}
      >
        {links.map(([slug, label]) => (
          <a
            href={`${base}#${slug}`}
            aria-current={page === `/${slug}/` ? "page" : undefined}
          >
            {label}
          </a>
        ))}
      </nav>
      <div class="header-actions">
        {!current.startsWith("/publications/") && (
          <a
            class="language"
            href={alternate}
            lang={es ? "en" : "es"}
            aria-label={es ? "English version" : "Versión en español"}
          >
            {es ? "EN" : "ES"}
          </a>
        )}
        <a
          class="cv-link"
          href="https://drive.google.com/file/d/1vwPQEI_GvsCVWiBJQ5meD143yRfUaTRw/view?usp=sharing"
        >
          CV
        </a>
        <details class="mobile-menu">
          <summary>
            {es ? "Menú" : "Menu"} <span aria-hidden="true">+</span>
          </summary>
          <nav aria-label={es ? "Navegación móvil" : "Mobile navigation"}>
            {links.map(([slug, label]) => (
              <a
                href={`${base}#${slug}`}
                aria-current={page === `/${slug}/` ? "page" : undefined}
              >
                {label}
              </a>
            ))}
          </nav>
        </details>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer wrap">
      <div class="footer-top">
        <a href={base} class="footer-name">
          Moacir Fonseca Becker
        </a>
        <div class="footer-social">
          <a href="https://www.instagram.com/astro_moa/">
            <SocialIcon name="instagram" />
            Instagram
          </a>
          <a href="https://wa.me/50684365396">
            <SocialIcon name="whatsapp" />
            WhatsApp
          </a>
          <a href="https://www.linkedin.com/in/moacirfb/">
            <SocialIcon name="linkedin" />
            LinkedIn
          </a>
          <a href="https://www.researchgate.net/profile/Moacir-Fonseca-Becker">
            <SocialIcon name="researchgate" />
            ResearchGate
          </a>
          <a href="https://scholar.google.com/citations?hl=en&user=wc3XeSoAAAAJ">
            <SocialIcon name="scholar" />
            Google Scholar
          </a>
        </div>
      </div>
      <div class="footer-bottom">
        <span>
          © {new Date().getFullYear()} ·{" "}
          {es ? "West Lafayette, Indiana" : "West Lafayette, Indiana"}
        </span>

        <a href="mailto:mfonsec@purdue.edu">
          <SocialIcon name="email" />
          mfonsec@purdue.edu
        </a>
      </div>
    </footer>
    <script>
      const reduced = matchMedia("(prefers-reduced-motion: reduce)");
      const videos = [
        ...document.querySelectorAll<HTMLVideoElement>("[data-space-video]"),
      ];
      let paused = reduced.matches;
      const visible = new Set<HTMLVideoElement>();
      const stars = document.querySelector<HTMLElement>(".starfield");
      const trails = document.querySelector<HTMLElement>(".star-trails");
      const constellations = document.querySelector<SVGElement>(".constellations");
      let scrollFrame = 0;
      let previousScroll = scrollY;
      let previousTime = performance.now();
      let trailTimer = 0;
      function updateStars() {
        scrollFrame = 0;
        const offset = -((scrollY * 0.22) % 575);
        if (stars) stars.style.transform = paused ? "none" : `translate3d(0, ${offset}px, 0)`;
        if (constellations)
          constellations.style.transform = paused ? "none" : `translate3d(0, ${offset * 0.28}px, 0)`;
      }
      addEventListener(
        "scroll",
        () => {
          if (paused) return;
          const now = performance.now();
          const delta = scrollY - previousScroll;
          const elapsed = Math.max(16, now - previousTime);
          const speed = Math.min(1, Math.abs(delta) / elapsed / 1.4);
          previousScroll = scrollY;
          previousTime = now;
          if (trails && speed > .05) {
            const direction = delta >= 0 ? -1 : 1;
            trails.classList.add("is-warping");
            trails.classList.toggle("trails-upward", delta >= 0);
            trails.style.opacity = String(.12 + speed * .3);
            trails.style.setProperty("--trail-length", `${7 + speed * 48}px`);
            trails.style.setProperty("--warp-shift", `${direction * speed * 22}px`);
            clearTimeout(trailTimer);
            trailTimer = window.setTimeout(() => {
              trails.classList.remove("is-warping");
              trails.style.opacity = "0";
              trails.style.setProperty("--trail-length", "2px");
              trails.style.setProperty("--warp-shift", "0px");
            }, 180);
          }
          if (!scrollFrame) scrollFrame = requestAnimationFrame(updateStars);
        },
        { passive: true },
      );
      addEventListener("resize", updateStars, { passive: true });
      document.querySelectorAll(".mobile-menu a").forEach((link) =>
        link.addEventListener("click", () => {
          link.closest("details")?.removeAttribute("open");
        }),
      );
      function revealAnchor() {
        const target = document.getElementById(
          decodeURIComponent(location.hash.slice(1)),
        );
        if (!target) return;
        let parent = target.parentElement;
        let opened = false;
        while (parent) {
          if (parent instanceof HTMLDetailsElement && !parent.open) {
            parent.open = true;
            opened = true;
          }
          parent = parent.parentElement;
        }
        if (opened) target.scrollIntoView();
      }
      addEventListener("hashchange", revealAnchor);
      revealAnchor();
      function syncMotion() {
        updateStars();
        document.documentElement.dataset.motion = paused ? "off" : "on";
        videos.forEach((video) => {
          if (paused || document.hidden || !visible.has(video)) {
            video.pause();
            return;
          }
          if (!video.getAttribute("src")) video.src = video.dataset.src!;
          video.play().catch(() => {
            /* The poster remains available when autoplay is blocked. */
          });
        });
      }
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) =>
            entry.isIntersecting
              ? visible.add(entry.target as HTMLVideoElement)
              : visible.delete(entry.target as HTMLVideoElement),
          );
          syncMotion();
        },
        { threshold: 0.05 },
      );
      videos.forEach((video) => observer.observe(video));
      reduced.addEventListener("change", () => {
        paused = reduced.matches;
        syncMotion();
      });
      document.addEventListener("visibilitychange", syncMotion);
      syncMotion();
    </script>
  </body>
</html>
