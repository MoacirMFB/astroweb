---
import SocialIcon from "../components/SocialIcon.astro";
import CosmicBackdrop from "../components/CosmicBackdrop.astro";
import "../styles/site.css";
interface Props {
  title?: string;
  description?: string;
  lang?: string;
}
const {
  title = "Moacir Fonseca Becker | Asteroid exploration & astrodynamics",
  description = "Asteroid interception, exploration, and space mission design. Moacir Fonseca Becker, PhD student in Aeronautics and Astronautics at Purdue University.",
  lang = "en",
} = Astro.props;
const es = lang === "es";
const base = es ? "/es/" : "/";
const current = Astro.url.pathname;
const page = current.replace(/^\/es\/?/, "/");
const alternate = es ? page : "/es" + current;
const links = [
  ["research", es ? "Investigación" : "Research"],
  ["projects", es ? "Proyectos" : "Projects"],
  ["about", es ? "Sobre mí" : "About"],
  ["contact", es ? "Contacto" : "Contact"],
];
---

<!doctype html>
<html lang={lang} data-motion="off">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#080c11" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta
      property="og:image"
      content="https://moacir.space/space/bennu-spin.jpg"
    />
    <link rel="canonical" href={new URL(current, Astro.site)} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body>
    <CosmicBackdrop />
    <a class="skip-link" href="#main">
      {es ? "Ir al contenido" : "Skip to content"}
    </a>
    <header class="site-header wrap">
      <a class="brand" href={base} aria-label="Moacir Fonseca Becker, home">
        <svg viewBox="0 0 44 44" aria-hidden="true">
          <circle cx="22" cy="22" r="10" />
          <ellipse
            cx="22"
            cy="22"
            rx="21"
            ry="7"
            transform="rotate(-40 22 22)"
          />
          <circle class="brand-dot" cx="36" cy="10" r="3" />
        </svg>
        <span>
          Moacir<span class="brand-surname">Fonseca Becker</span>
        </span>
      </a>
      <nav
        class="desktop-nav"
        aria-label={es ? "Navegación principal" : "Main navigation"}
      >
        {links.map(([slug, label]) => (
          <a
            href={`${base}#${slug}`}
            aria-current={page === `/${slug}/` ? "page" : undefined}
          >
            {label}
          </a>
        ))}
      </nav>
      <div class="header-actions">
        {!current.startsWith("/publications/") && (
          <a
            class="language"
            href={alternate}
            lang={es ? "en" : "es"}
            aria-label={es ? "English version" : "Versión en español"}
          >
            {es ? "EN" : "ES"}
          </a>
        )}
        <a
          class="cv-link"
          href="https://drive.google.com/file/d/1vwPQEI_GvsCVWiBJQ5meD143yRfUaTRw/view?usp=sharing"
        >
          CV
        </a>
        <details class="mobile-menu">
          <summary>
            {es ? "Menú" : "Menu"} <span aria-hidden="true">+</span>
          </summary>
          <nav aria-label={es ? "Navegación móvil" : "Mobile navigation"}>
            {links.map(([slug, label]) => (
              <a
                href={`${base}#${slug}`}
                aria-current={page === `/${slug}/` ? "page" : undefined}
              >
                {label}
              </a>
            ))}
          </nav>
        </details>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer wrap">
      <div class="footer-top">
        <a href={base} class="footer-name">
          Moacir Fonseca Becker
        </a>
        <div class="footer-social">
          <a href="https://www.instagram.com/astro_moa/">
            <SocialIcon name="instagram" />
            Instagram
          </a>
          <a href="https://wa.me/50684365396">
            <SocialIcon name="whatsapp" />
            WhatsApp
          </a>
          <a href="https://www.linkedin.com/in/moacirfb/">
            <SocialIcon name="linkedin" />
            LinkedIn
          </a>
          <a href="https://www.researchgate.net/profile/Moacir-Fonseca-Becker">
            <SocialIcon name="researchgate" />
            ResearchGate
          </a>
          <a href="https://scholar.google.com/citations?hl=en&user=wc3XeSoAAAAJ">
            <SocialIcon name="scholar" />
            Google Scholar
          </a>
        </div>
      </div>
      <div class="footer-bottom">
        <span>
          © {new Date().getFullYear()} ·{" "}
          {es ? "West Lafayette, Indiana" : "West Lafayette, Indiana"}
        </span>

        <a href="mailto:mfonsec@purdue.edu">
          <SocialIcon name="email" />
          mfonsec@purdue.edu
        </a>
      </div>
    </footer>
    <script>
      const reduced = matchMedia("(prefers-reduced-motion: reduce)");
      const videos = [
        ...document.querySelectorAll<HTMLVideoElement>("[data-space-video]"),
      ];
      let paused = reduced.matches;
      const visible = new Set<HTMLVideoElement>();
      const travelCanvas = document.querySelector<HTMLCanvasElement>("[data-star-travel]");
      const travelContext = travelCanvas?.getContext("2d");
      const backdrop = document.querySelector<HTMLElement>(".cosmic-backdrop");
      type TravelStar = {
        x: number;
        y: number;
        z: number;
        previousZ: number;
        size: number;
        tone: number;
      };
      let travelStars: TravelStar[] = [];
      let travelWidth = innerWidth;
      let travelHeight = innerHeight;
      let travelSeed = 92821;
      let travelFrame = 0;
      let previousScroll = scrollY;
      let previousTime = performance.now();
      let previousTravelTime = performance.now();
      let travelVelocity = 0;
      const travelRandom = () =>
        ((travelSeed = (travelSeed * 48271) % 2147483647) / 2147483647);
      function makeTravelStar(z = .24 + travelRandom() * 1.46): TravelStar {
        let x = (travelRandom() - .5) * z * 1.65;
        let y = (travelRandom() - .5) * z * 1.65;
        if (Math.abs(x) < z * .07 && Math.abs(y) < z * .07) x += z * .12;
        return {
          x,
          y,
          z,
          previousZ: z,
          size: .35 + travelRandom() * 1.2,
          tone: travelRandom(),
        };
      }
      function resizeTravel() {
        if (!travelCanvas || !travelContext) return;
        const pixelRatio = Math.min(devicePixelRatio || 1, 2);
        travelWidth = innerWidth;
        travelHeight = innerHeight;
        travelCanvas.width = Math.round(travelWidth * pixelRatio);
        travelCanvas.height = Math.round(travelHeight * pixelRatio);
        travelContext.setTransform(pixelRatio, 0, 0, pixelRatio, 0, 0);
        const starCount = travelWidth < 760 ? 130 : 200;
        if (travelStars.length !== starCount)
          travelStars = Array.from({ length: starCount }, () => makeTravelStar());
        drawTravel(0, 0);
      }
      function projectTravelStar(star: TravelStar, z: number) {
        const field = Math.min(travelWidth, travelHeight) * .54;
        return {
          x: travelWidth * .5 + (star.x / z) * field,
          y: travelHeight * .48 + (star.y / z) * field,
        };
      }
      function drawTravel(speed: number, deltaTime: number) {
        if (!travelCanvas || !travelContext) return;
        const moving = speed >= .008 && deltaTime > 0;
        const outward = travelVelocity > 0;
        const depthStep = moving ? travelVelocity * deltaTime * .0022 : 0;
        const alpha = .07 + speed * .11;
        travelContext.clearRect(0, 0, travelWidth, travelHeight);
        travelContext.globalCompositeOperation = "source-over";
        travelContext.lineCap = "round";
        for (let index = 0; index < travelStars.length; index += 1) {
          let star = travelStars[index];
          star.previousZ = star.z;
          if (moving) star.z -= depthStep;
          if (star.z < .13) star = travelStars[index] = makeTravelStar(1.68);
          if (star.z > 1.72) star = travelStars[index] = makeTravelStar(.16);
          const current = projectTravelStar(star, star.z);
          const previous = projectTravelStar(star, star.previousZ);
          if (
            current.x < -travelWidth * .18 || current.x > travelWidth * 1.18 ||
            current.y < -travelHeight * .18 || current.y > travelHeight * 1.18
          ) {
            travelStars[index] = makeTravelStar(
              moving ? (outward ? 1.68 : .16) : .32 + travelRandom() * 1.2,
            );
            continue;
          }
          const stretch = 3 + speed * 9;
          const tailX = current.x + (previous.x - current.x) * stretch;
          const tailY = current.y + (previous.y - current.y) * stretch;
          const apparentSize = Math.min(2.2, star.size * (.62 + 1 / star.z * .32));
          if (moving) {
            travelContext.strokeStyle = outward
              ? `rgba(226, 115, 90, ${alpha})`
              : `rgba(98, 158, 224, ${alpha})`;
            travelContext.lineWidth = .18 + apparentSize * .32;
            travelContext.beginPath();
            travelContext.moveTo(tailX, tailY);
            travelContext.lineTo(current.x, current.y);
            travelContext.stroke();
          }
          const restingAlpha = Math.min(.78, .34 + (1.72 - star.z) * .24);
          travelContext.fillStyle = moving
            ? outward
              ? `rgba(255, 225, 211, ${Math.min(.68, alpha + .18)})`
              : `rgba(218, 237, 255, ${Math.min(.68, alpha + .18)})`
            : star.tone < .18
              ? `rgba(255, 231, 204, ${restingAlpha})`
              : star.tone > .78
                ? `rgba(205, 229, 255, ${restingAlpha})`
                : `rgba(241, 247, 255, ${restingAlpha})`;
          travelContext.beginPath();
          travelContext.arc(current.x, current.y, apparentSize * .62, 0, Math.PI * 2);
          travelContext.fill();
        }
      }
      function animateTravel(time: number) {
        travelFrame = 0;
        if (!travelCanvas || !travelContext || !backdrop || document.hidden) {
          return;
        }
        if (paused) {
          drawTravel(0, 0);
          return;
        }
        const deltaTime = Math.min(34, Math.max(8, time - previousTravelTime));
        previousTravelTime = time;
        const speed = Math.min(1, Math.abs(travelVelocity));
        if (speed < .008) {
          travelVelocity = 0;
          backdrop.classList.remove("shift-red", "shift-blue");
          backdrop.style.setProperty("--shift-opacity", "0");
          drawTravel(0, 0);
          return;
        }
        const outward = travelVelocity > 0;
        backdrop.classList.toggle("shift-red", outward);
        backdrop.classList.toggle("shift-blue", !outward);
        backdrop.style.setProperty("--shift-color", outward ? "#a9412c2e" : "#2b68c92b");
        backdrop.style.setProperty("--shift-opacity", String(.04 + speed * .1));
        drawTravel(speed, deltaTime);
        travelVelocity *= Math.pow(.965, deltaTime / 16.67);
        travelFrame = requestAnimationFrame(animateTravel);
      }
      resizeTravel();
      addEventListener(
        "scroll",
        () => {
          if (paused) return;
          const now = performance.now();
          const delta = scrollY - previousScroll;
          const elapsed = Math.max(16, now - previousTime);
          const velocity = Math.max(-1, Math.min(1, delta / elapsed / .32));
          previousScroll = scrollY;
          previousTime = now;
          if (Math.abs(velocity) > .025) {
            travelVelocity =
              travelVelocity && Math.sign(travelVelocity) !== Math.sign(velocity)
                ? velocity
                : travelVelocity * .32 + velocity * .68;
            if (!travelFrame) {
              previousTravelTime = now;
              travelFrame = requestAnimationFrame(animateTravel);
            }
          }
        },
        { passive: true },
      );
      addEventListener(
        "resize",
        () => {
          resizeTravel();
        },
        { passive: true },
      );
      document.querySelectorAll(".mobile-menu a").forEach((link) =>
        link.addEventListener("click", () => {
          link.closest("details")?.removeAttribute("open");
        }),
      );
      function revealAnchor() {
        const target = document.getElementById(
          decodeURIComponent(location.hash.slice(1)),
        );
        if (!target) return;
        let parent = target.parentElement;
        let opened = false;
        while (parent) {
          if (parent instanceof HTMLDetailsElement && !parent.open) {
            parent.open = true;
            opened = true;
          }
          parent = parent.parentElement;
        }
        if (opened) target.scrollIntoView();
      }
      addEventListener("hashchange", revealAnchor);
      revealAnchor();
      function syncMotion() {
        document.documentElement.dataset.motion = paused ? "off" : "on";
        if (paused && backdrop) {
          travelVelocity = 0;
          if (travelFrame) cancelAnimationFrame(travelFrame);
          travelFrame = 0;
          backdrop.classList.remove("shift-red", "shift-blue");
          backdrop.style.setProperty("--shift-opacity", "0");
          drawTravel(0, 0);
        } else if (!travelFrame) {
          drawTravel(0, 0);
        }
        videos.forEach((video) => {
          if (paused || document.hidden || !visible.has(video)) {
            video.pause();
            return;
          }
          if (!video.getAttribute("src")) video.src = video.dataset.src!;
          video.play().catch(() => {
            /* The poster remains available when autoplay is blocked. */
          });
        });
      }
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) =>
            entry.isIntersecting
              ? visible.add(entry.target as HTMLVideoElement)
              : visible.delete(entry.target as HTMLVideoElement),
          );
          syncMotion();
        },
        { threshold: 0.05 },
      );
      videos.forEach((video) => observer.observe(video));
      reduced.addEventListener("change", () => {
        paused = reduced.matches;
        syncMotion();
      });
      document.addEventListener("visibilitychange", syncMotion);
      syncMotion();
    </script>
  </body>
</html>
