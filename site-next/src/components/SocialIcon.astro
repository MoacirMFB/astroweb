---
interface Props {
  name:
    | "linkedin"
    | "researchgate"
    | "scholar"
    | "email"
    | "instagram"
    | "facebook"
    | "whatsapp";
}
const { name } = Astro.props;
---

<svg
  class="social-icon"
  viewBox="0 0 24 24"
  aria-hidden="true"
  focusable="false"
>
  {name === "linkedin" && (
    <path
      fill="currentColor"
      d="M20.45 2H3.55C2.69 2 2 2.68 2 3.52v16.96C2 21.32 2.69 22 3.55 22h16.9c.86 0 1.55-.68 1.55-1.52V3.52C22 2.68 21.31 2 20.45 2ZM7.93 18.75H4.98V9.2h2.95v9.55ZM6.45 7.9a1.71 1.71 0 1 1 0-3.42 1.71 1.71 0 0 1 0 3.42Zm12.3 10.85H15.8V14.1c0-1.11-.02-2.54-1.55-2.54-1.55 0-1.79 1.21-1.79 2.46v4.73H9.51V9.2h2.83v1.3h.04c.39-.74 1.36-1.53 2.79-1.53 2.99 0 3.55 1.97 3.55 4.53v5.25Z"
    />
  )}
  {name === "researchgate" && (
    <>
      <path
        d="M4 20V7h5a4 4 0 0 1 0 8H4m5 0 5 5"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
      />
      <path
        d="M21 4.5A4 4 0 1 0 21 10V7h-3"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
      />
    </>
  )}
  {name === "scholar" && (
    <>
      <path d="M12 2 0 10l12 8 12-8-12-8Z" fill="currentColor" />
      <path d="M5 15v5c4 3 10 3 14 0v-5l-7 5-7-5Z" fill="currentColor" />
    </>
  )}
  {name === "email" && (
    <g
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linejoin="round"
    >
      <rect x="2" y="4" width="20" height="16" rx="2" />
      <path d="m3 6 9 7 9-7" />
    </g>
  )}
  {name === "instagram" && (
    <g fill="none" stroke="currentColor" stroke-width="1.7">
      <rect x="3" y="3" width="18" height="18" rx="5" />
      <circle cx="12" cy="12" r="4" />
      <circle cx="17.5" cy="6.5" r=".8" fill="currentColor" stroke="none" />
    </g>
  )}
  {name === "facebook" && (
    <path
      fill="currentColor"
      d="M14.6 22v-9.1h3.1l.5-3.6h-3.6V7c0-1 .3-1.7 1.8-1.7h1.9V2.1A25 25 0 0 0 15.6 2c-2.8 0-4.7 1.7-4.7 4.8v2.5H8v3.6h2.9V22h3.7Z"
    />
  )}
  {name === "whatsapp" && (
    <>
      <path
        d="M4.6 18.4 3 22l4.4-1.2A9.5 9.5 0 1 0 4.6 18.4Z"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
      />
      <path
        d="m8 6-1 2c-.4 3 4 7.4 7 8l2-1 .5-2-3-1-1 1c-1.4-.7-2.8-2.1-3.5-3.5l1-1L9 6H8Z"
        fill="currentColor"
      />
    </>
  )}
</svg>
