---
import transfer from "../data/transfer.json";
const { lang = "en" } = Astro.props;
---

<figure class="diagram">
  <svg
    class="orbit-diagram"
    viewBox="0 0 520 450"
    role="img"
    aria-label={
      lang === "es"
        ? "Transferencia heliocéntrica de Lambert desde la órbita terrestre hasta un asteroide hipotético"
        : "Heliocentric Lambert transfer from Earth’s orbit to a hypothetical asteroid"
    }
  >
    <defs>
      <radialGradient id="sun-glow">
        <stop stop-color="#fff2c8" stop-opacity=".32" />
        <stop offset="1" stop-color="#fff2c8" stop-opacity="0" />
      </radialGradient>
      <radialGradient id="sun-disc" cx="38%" cy="35%">
        <stop stop-color="#fffdf1" />
        <stop offset=".75" stop-color="#f2dba4" />
        <stop offset="1" stop-color="#ba9661" />
      </radialGradient>
      <radialGradient id="earth-disc" cx="25%" cy="30%">
        <stop stop-color="#c0e5ff" />
        <stop offset=".3" stop-color="#659bc4" />
        <stop offset=".65" stop-color="#254f7a" />
        <stop offset="1" stop-color="#0c1524" />
      </radialGradient>
      <linearGradient id="transfer-glow">
        <stop stop-color="#79baff" stop-opacity=".3" />
        <stop offset=".6" stop-color="#79baff" />
        <stop offset="1" stop-color="#d0e7ff" />
      </linearGradient>
    </defs>
    <circle
      cx="245"
      cy="230"
      r="104"
      fill="none"
      stroke="#79baff"
      stroke-opacity=".28"
      stroke-width=".8"
    />
    <path
      d={transfer.asteroidOrbit}
      fill="none"
      stroke="#a1a9b3"
      stroke-opacity=".25"
      stroke-dasharray="2 6"
      stroke-width=".8"
    />
    <circle cx="245" cy="230" r="55" fill="url(#sun-glow)" />
    <circle cx="245" cy="230" r="15" fill="url(#sun-disc)" />
    <path
      d={transfer.transfer}
      fill="none"
      stroke="#79baff"
      stroke-opacity=".08"
      stroke-width="8"
    />
    <path
      d={transfer.transfer}
      fill="none"
      stroke="url(#transfer-glow)"
      stroke-width="1.8"
    />
    <g transform={`translate(${transfer.earth.join(" ")})`}>
      <circle r="13" fill="#79baff" opacity=".1" />
      <circle r="10" fill="url(#earth-disc)" />
      <path
        d="M-5-7l-2 4 3 2 2 5 3-4-1-4zM3 3l-2 3 1 3 3-4z"
        fill="#a1c6bc"
        opacity=".7"
      />
    </g>
    <image
      href="/space/bennu-spin.jpg"
      x={transfer.asteroid[0] - 15}
      y={transfer.asteroid[1] - 15}
      width="30"
      height="30"
      style="mix-blend-mode:screen"
    />
    <circle
      cx={transfer.midpoint[0]}
      cy={transfer.midpoint[1]}
      r="2.5"
      fill="#e6f3ff"
    />
  </svg>
</figure>
