---
interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
---

<span class:list={["satellite-toggle", { compact }]} aria-hidden="true">
  <svg viewBox="0 0 76 34">
    <g class="panel panel-left">
      <rect x="3" y="10" width="23" height="14" rx="1.5" />
      <path d="M10.7 10v14M18.3 10v14M3 17h23" />
    </g>
    <g class="panel panel-right">
      <rect x="50" y="10" width="23" height="14" rx="1.5" />
      <path d="M57.7 10v14M65.3 10v14M50 17h23" />
    </g>
    <rect class="body" x="27" y="7" width="22" height="20" rx="4" />
    <circle class="lens" cx="38" cy="17" r="4" />
    <path class="antenna" d="M38 7V3m-5 0h10M34 29l4-2 4 2" />
  </svg>
</span>

<style>
  .satellite-toggle {
    display: inline-grid;
    place-items: center;
    width: 62px;
    flex: 0 0 auto;
    color: #79baff;
  }
  .satellite-toggle.compact {
    width: 43px;
  }
  svg {
    display: block;
    width: 100%;
    overflow: visible;
  }
  rect,
  path,
  circle {
    vector-effect: non-scaling-stroke;
  }
  .body {
    fill: #132b43;
    stroke: currentColor;
    stroke-width: 1.2;
  }
  .lens {
    fill: #cde8ff;
    stroke: currentColor;
    stroke-width: 1;
    filter: drop-shadow(0 0 3px #79baff);
  }
  .antenna {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.2;
    stroke-linecap: round;
    transition: transform 420ms cubic-bezier(.2, .8, .2, 1);
    transform-origin: 38px 17px;
  }
  .panel {
    fill: #183d61;
    stroke: currentColor;
    stroke-width: 1;
    transition: transform 520ms cubic-bezier(.2, .8, .2, 1);
  }
  .panel path {
    fill: none;
    stroke: #9dccff99;
    stroke-width: .7;
  }
  .panel-left {
    transform: translateX(21px) scaleX(.18);
    transform-origin: 27px 17px;
  }
  .panel-right {
    transform: translateX(-21px) scaleX(.18);
    transform-origin: 49px 17px;
  }
  :global(details[open] > summary) .panel-left,
  :global(details[open] > summary) .panel-right {
    transform: translateX(0) scaleX(1);
  }
  :global(details[open] > summary) .antenna {
    transform: rotate(8deg);
  }
  :global(summary:hover) .lens {
    fill: #fff;
  }
  @media (prefers-reduced-motion: reduce) {
    .panel,
    .antenna {
      transition: none;
    }
  }
</style>
