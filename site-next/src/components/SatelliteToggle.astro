---
interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
---

<span class:list={["satellite-toggle", { compact }]} aria-hidden="true">
  <svg viewBox="0 0 90 42">
    <g class="panel panel-left">
      <rect x="3" y="14" width="28" height="16" rx="1.5" />
      <path d="M10 14v16m7-16v16m7-16v16M3 22h28" />
    </g>
    <g class="panel panel-right">
      <rect x="59" y="14" width="28" height="16" rx="1.5" />
      <path d="M66 14v16m7-16v16m7-16v16M59 22h28" />
    </g>
    <path class="bus" d="M31 12l5-4h18l5 4v19l-5 4H36l-5-4z" />
    <rect class="bus-face" x="37" y="15" width="16" height="13" rx="2" />
    <circle class="sensor" cx="45" cy="21.5" r="3" />
    <path class="dish" d="M36 5q9 12 18 0M45 10V5" />
    <circle class="dish-tip" cx="45" cy="4.5" r="1.7" />
    <path class="thrusters" d="M38 35l2 4h10l2-4" />
  </svg>
</span>

<style>
  .satellite-toggle {
    display: inline-grid;
    place-items: center;
    width: 70px;
    flex: 0 0 auto;
    color: #79baff;
  }
  .satellite-toggle.compact {
    width: 48px;
  }
  svg {
    display: block;
    width: 100%;
    overflow: visible;
  }
  rect,
  path,
  circle {
    vector-effect: non-scaling-stroke;
  }
  .bus {
    fill: #bca36a;
    stroke: #f2d79b;
    stroke-width: 1.2;
  }
  .bus-face {
    fill: #132b43;
    stroke: currentColor;
    stroke-width: .8;
  }
  .sensor {
    fill: #cde8ff;
    stroke: currentColor;
    stroke-width: 1;
    filter: drop-shadow(0 0 3px #79baff);
  }
  .dish,
  .thrusters {
    fill: none;
    stroke: #e9eef2;
    stroke-width: 1.2;
    stroke-linecap: round;
    transition: transform 420ms cubic-bezier(.2, .8, .2, 1);
    transform-origin: 45px 10px;
  }
  .dish-tip {
    fill: #f4faff;
    filter: drop-shadow(0 0 3px #79baff);
  }
  .panel {
    fill: #183d61;
    stroke: currentColor;
    stroke-width: 1;
    transition: transform 520ms cubic-bezier(.2, .8, .2, 1);
  }
  .panel path {
    fill: none;
    stroke: #9dccff99;
    stroke-width: .7;
  }
  .panel-left {
    transform: translateX(14px) scaleX(.5);
    transform-origin: 31px 22px;
  }
  .panel-right {
    transform: translateX(-14px) scaleX(.5);
    transform-origin: 59px 22px;
  }
  :global(details[open] > summary) .panel-left,
  :global(details[open] > summary) .panel-right {
    transform: translateX(0) scaleX(1);
  }
  :global(details[open] > summary) .dish {
    transform: rotate(8deg);
  }
  :global(summary:hover) .sensor {
    fill: #fff;
  }
  @media (prefers-reduced-motion: reduce) {
    .panel,
    .dish {
      transition: none;
    }
  }
</style>
