---
const constellations = [
  {
    points: "145,720 220,682 294,704 365,675 430,618 504,603 558,650",
  },
  {
    points: "172,176 230,126 293,174 360,112 430,166",
  },
  {
    points: "770,122 814,205 855,290",
    cross: "741,218 814,205 910,185",
  },
  {
    points: "1132,410 1190,470 1248,446 1292,526 1230,586 1160,548 1190,470",
    cross: "1175,505 1216,512 1257,518",
  },
] as const;

let seed = 7319;
const random = () => ((seed = (seed * 48271) % 2147483647) / 2147483647);
const warpStars = Array.from({ length: 96 }, (_, index) => ({
  left: random() * 100,
  top: random() * 100,
  size: `${(0.45 + random() * 0.75).toFixed(2)}px`,
  delay: `${(index % 9) * -18}ms`,
})).map((star) => ({
  ...star,
  left: `${star.left.toFixed(2)}%`,
  top: `${star.top.toFixed(2)}%`,
  angle: `${(Math.atan2(star.top - 50, star.left - 50) * 180 / Math.PI).toFixed(2)}deg`,
}));
---

<div class="cosmic-backdrop" data-starfield-root aria-hidden="true">
  <div class="starfield"></div>
  <div class="star-trails">
    {warpStars.map((star) => (
      <i
        style={`--left:${star.left};--top:${star.top};--star-size:${star.size};--delay:${star.delay};--travel-angle:${star.angle}`}
      ></i>
    ))}
  </div>
  <svg class="constellations" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMid slice">
    {constellations.map((constellation) => (
      <g>
        {constellation.points.split(" ").map((point) => {
          const [cx, cy] = point.split(",");
          return <circle cx={cx} cy={cy} r="1.35" />;
        })}
        {constellation.cross?.split(" ").map((point) => {
          const [cx, cy] = point.split(",");
          return <circle cx={cx} cy={cy} r="1.15" />;
        })}
      </g>
    ))}
  </svg>
</div>

<style>
  .cosmic-backdrop {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
    background:
      radial-gradient(ellipse at 82% 18%, #12305245, transparent 48%),
      radial-gradient(ellipse at 16% 72%, #10253e2d, transparent 42%);
  }
  .cosmic-backdrop::after {
    content: "";
    position: absolute;
    inset: 0;
    opacity: 0;
    background: radial-gradient(circle at 50% 48%, transparent 18%, var(--shift-color, transparent) 100%);
    transition: opacity 650ms ease;
  }
  .cosmic-backdrop.shift-red::after,
  .cosmic-backdrop.shift-blue::after {
    opacity: var(--shift-opacity, 0);
  }
  .starfield {
    position: absolute;
    inset: -1000px 0;
    background:
      url("/space/stars.svg") repeat center top / 920px 575px,
      url("/space/stars.svg") repeat 313px 187px / 1270px 794px;
    will-change: transform;
    opacity: .84;
    filter: brightness(1.65) drop-shadow(0 0 1px #79baff66);
  }
  .star-trails {
    position: absolute;
    inset: 0;
    opacity: 0;
    transform-origin: 50% 48%;
    transition:
      opacity 700ms ease,
      transform 700ms cubic-bezier(.16, .72, .25, 1);
  }
  .star-trails.is-warping {
    transition-duration: 70ms;
  }
  .star-trails i {
    position: absolute;
    left: var(--left);
    top: var(--top);
    width: var(--star-size);
    height: var(--star-size);
    border-radius: 50%;
    background: #f4faff;
    box-shadow: 0 0 2px #dceeffb3;
    transform: translate(-50%, -50%);
    will-change: transform;
    transition:
      background 180ms ease,
      box-shadow 180ms ease;
    transition-delay: var(--delay);
  }
  .star-trails i::after {
    content: "";
    position: absolute;
    top: 50%;
    right: 50%;
    width: var(--trail-length, 2px);
    height: max(1px, var(--star-size));
    border-radius: 999px;
    background: linear-gradient(to right, transparent, #d8eaff6b 52%, #f4faff 100%);
    transform: translateY(-50%) rotate(var(--travel-angle));
    transform-origin: right center;
    transition:
      width 700ms cubic-bezier(.16, .72, .25, 1),
      background 180ms ease;
    transition-delay: var(--delay);
  }
  .star-trails.travel-outward i {
    background: #fff1e9;
    box-shadow: 0 0 3px #ff755a99;
  }
  .star-trails.travel-outward i::after {
    background: linear-gradient(to right, transparent, #da4c4652 48%, #ff9a77b8 80%, #fff1e9 100%);
  }
  .star-trails.travel-inward i {
    background: #eaf5ff;
    box-shadow: 0 0 3px #64a7ff99;
  }
  .star-trails.travel-inward i::after {
    left: 50%;
    right: auto;
    background: linear-gradient(to right, #eaf5ff 0%, #72b8ffb8 20%, #356dff52 52%, transparent 100%);
    transform-origin: left center;
  }
  .constellations {
    position: absolute;
    inset: -5%;
    width: 110%;
    height: 110%;
    overflow: visible;
    opacity: .62;
    will-change: transform;
  }
  .constellations circle {
    fill: #e7f4ff;
    opacity: .76;
    filter: drop-shadow(0 0 2px #79baff99);
  }
  @media (max-width: 760px) {
    .starfield {
      background-size: 760px 475px, 980px 613px;
    }
    .constellations {
      width: 150%;
      left: -25%;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .starfield,
    .star-trails,
    .constellations {
      transform: none !important;
      will-change: auto;
    }
    .star-trails {
      display: none;
    }
  }
</style>
