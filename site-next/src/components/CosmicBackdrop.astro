---
const constellations = [
  {
    points: "145,720 220,682 294,704 365,675 430,618 504,603 558,650",
  },
  {
    points: "172,176 230,126 293,174 360,112 430,166",
  },
  {
    points: "770,122 814,205 855,290",
    cross: "741,218 814,205 910,185",
  },
  {
    points: "1132,410 1190,470 1248,446 1292,526 1230,586 1160,548 1190,470",
    cross: "1175,505 1216,512 1257,518",
  },
] as const;

let seed = 7319;
const random = () => ((seed = (seed * 48271) % 2147483647) / 2147483647);
const warpStars = Array.from({ length: 96 }, (_, index) => ({
  left: `${(random() * 100).toFixed(2)}%`,
  top: `${(random() * 100).toFixed(2)}%`,
  size: `${(0.8 + random() * 1.8).toFixed(2)}px`,
  delay: `${(index % 9) * -18}ms`,
}));
---

<div class="cosmic-backdrop" data-starfield-root aria-hidden="true">
  <div class="starfield"></div>
  <div class="star-trails">
    {warpStars.map((star) => (
      <i
        style={`--left:${star.left};--top:${star.top};--star-size:${star.size};--delay:${star.delay}`}
      ></i>
    ))}
  </div>
  <svg class="constellations" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMid slice">
    {constellations.map((constellation) => (
      <g>
        {constellation.points.split(" ").map((point) => {
          const [cx, cy] = point.split(",");
          return <circle cx={cx} cy={cy} r="2.4" />;
        })}
        {constellation.cross?.split(" ").map((point) => {
          const [cx, cy] = point.split(",");
          return <circle cx={cx} cy={cy} r="2.1" />;
        })}
      </g>
    ))}
  </svg>
</div>

<style>
  .cosmic-backdrop {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
    background:
      radial-gradient(ellipse at 82% 18%, #12305245, transparent 48%),
      radial-gradient(ellipse at 16% 72%, #10253e2d, transparent 42%);
  }
  .starfield {
    position: absolute;
    inset: -1000px 0;
    background:
      url("/space/stars.svg") repeat center top / 920px 575px,
      url("/space/stars.svg") repeat 313px 187px / 1270px 794px;
    will-change: transform;
    opacity: .98;
    filter: brightness(2.35) drop-shadow(0 0 2px #79baffaa);
  }
  .star-trails {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 900ms ease;
  }
  .star-trails.is-warping {
    transition-duration: 80ms;
  }
  .star-trails i {
    position: absolute;
    left: var(--left);
    top: var(--top);
    width: var(--star-size);
    height: var(--trail-length, 2px);
    border-radius: 999px;
    background: linear-gradient(to bottom, #f4faff 0 2px, #9dccffd9 12%, #79baff66 52%, transparent 100%);
    box-shadow: 0 0 7px #9dccffcc;
    transform: translateY(var(--warp-shift, 0));
    transform-origin: center top;
    transition:
      height 850ms cubic-bezier(.16, .72, .25, 1),
      transform 850ms cubic-bezier(.16, .72, .25, 1);
    transition-delay: var(--delay);
  }
  .constellations {
    position: absolute;
    inset: -5%;
    width: 110%;
    height: 110%;
    overflow: visible;
    opacity: .78;
    will-change: transform;
  }
  .constellations circle {
    fill: #e7f4ff;
    opacity: .88;
    filter: drop-shadow(0 0 4px #79baff);
  }
  @media (max-width: 760px) {
    .starfield {
      background-size: 760px 475px, 980px 613px;
    }
    .constellations {
      width: 150%;
      left: -25%;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .starfield,
    .star-trails,
    .constellations {
      transform: none !important;
      will-change: auto;
    }
    .star-trails {
      display: none;
    }
  }
</style>
