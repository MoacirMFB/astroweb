---
import Layout from '../layouts/Layout.astro';

interface Props {
	title: string;
	authors: string;
	citationAuthors: string[];
	conferenceLine: string;
	abstractText: string;
	pdfHref: string;
	pdfUrl: string;
}

const { title, authors, citationAuthors, conferenceLine, abstractText, pdfHref, pdfUrl } =
	Astro.props;
---

<Layout
	title={`${title} | Moacir Fonseca Becker`}
	description={`${title}. ${conferenceLine}`}
>
	<Fragment slot="head">
		<meta name="citation_title" content={title} />
		{citationAuthors.map((author) => <meta name="citation_author" content={author} />)}
		<meta name="citation_publication_date" content="2026/06/01" />
		<meta
			name="citation_conference_title"
			content="30th International Symposium on Space Flight Dynamics"
		/>
		<meta name="citation_pdf_url" content={pdfUrl} />
	</Fragment>

	<main class="publication-page">
		<article class="publication-shell">
			<a class="back-link" href="/#publications">Publications</a>
			<p class="eyebrow">Conference paper</p>
			<h1>{title}</h1>
			<p class="authors">{authors}</p>
			<p class="conference">{conferenceLine}</p>

			<section aria-labelledby="abstract-heading">
				<h2 id="abstract-heading">Abstract</h2>
				<p>{abstractText}</p>
			</section>

			<a class="pdf-link" href={pdfHref}>Download PDF</a>
		</article>
	</main>
</Layout>

<style>
	:global(body) {
		--line: rgba(114, 176, 255, 0.26);
		--line-strong: rgba(145, 205, 255, 0.56);
		--text: #edf5ff;
		--text-soft: #acc7e8;
		--accent: #58b2ff;
		background: #000000;
		color: var(--text);
		color-scheme: dark;
		font-family: 'Avenir Next', 'Trebuchet MS', 'Segoe UI', sans-serif;
		line-height: 1.55;
		min-height: 100vh;
	}

	:global(html[data-theme='light'] body) {
		--line: rgba(40, 95, 161, 0.2);
		--line-strong: rgba(40, 95, 161, 0.42);
		--text: #12263f;
		--text-soft: #4f6684;
		--accent: #2168bf;
		background: #ffffff;
		color: var(--text);
		color-scheme: light;
	}

	.publication-page {
		min-height: 100vh;
		padding: clamp(2rem, 6vw, 5rem) clamp(1.1rem, 4vw, 3.8rem);
	}

	.publication-shell {
		border-left: 1px solid var(--line-strong);
		margin: 0 auto;
		max-width: 58rem;
		padding-left: clamp(1rem, 3vw, 2rem);
	}

	.back-link,
	.pdf-link {
		color: #9ecdf3;
		font-weight: 700;
		text-decoration: none;
	}

	.back-link:hover,
	.pdf-link:hover {
		color: #c5e7ff;
	}

	.eyebrow {
		color: var(--accent);
		font-size: 0.78rem;
		font-weight: 800;
		letter-spacing: 0;
		margin: 2.5rem 0 0.6rem;
		text-transform: uppercase;
	}

	h1 {
		color: var(--text);
		font-size: clamp(2rem, 6vw, 4rem);
		line-height: 0.98;
		margin: 0 0 1rem;
		max-width: 15ch;
	}

	.authors,
	.conference,
	section p {
		font-size: 1rem;
		max-width: 50rem;
	}

	.authors {
		color: #deecfb;
		font-weight: 700;
		margin: 0 0 0.5rem;
	}

	.conference,
	section p {
		color: var(--text-soft);
	}

	section {
		border-top: 1px solid var(--line);
		margin-top: 2rem;
		padding-top: 1.5rem;
	}

	h2 {
		font-size: 1rem;
		margin: 0 0 0.7rem;
	}

	.pdf-link {
		display: inline-block;
		margin-top: 1.3rem;
	}

	:global(html[data-theme='light']) .authors,
	:global(html[data-theme='light']) .back-link,
	:global(html[data-theme='light']) .pdf-link {
		color: #2168bf;
	}

	@media (max-width: 640px) {
		.publication-shell {
			padding-left: 1rem;
		}
	}
</style>
